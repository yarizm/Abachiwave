APP_ENV=development
DEMO_PROVIDER_NAME=local_deterministic_wav
AUDIO_TO_MIDI_PROVIDER_NAME=local_monophonic_wav_to_midi
BASIC_PITCH_SERVICE_URL=http://basic-pitch:8080
BASIC_PITCH_TIMEOUT_SECONDS=90
# Leave empty to disable provider routing: every upload kind then uses
# AUDIO_TO_MIDI_PROVIDER_NAME. Setting it redirects only `humming` uploads, which is
# the only kind with held-out evidence for the vocal pipeline.
HUMMING_AUDIO_TO_MIDI_PROVIDER_NAME=
YOURMT3_SERVICE_URL=http://yourmt3:8080
YOURMT3_TIMEOUT_SECONDS=600
# Host directory holding the YourMT3 checkpoint; it is not redistributed in this repo.
YOURMT3_CHECKPOINT_DIR=./models
DATABASE_URL=postgresql+asyncpg://abachiwave:abachiwave@localhost:5432/abachiwave
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=abachiwave-dev
TEXT_PROVIDER_API_BASE_URL=
TEXT_PROVIDER_API_KEY=
TEXT_PROVIDER_MODEL=
TEXT_PROVIDER_TIMEOUT_SECONDS=60
TEXT_EVALUATION_TIMEOUT_SECONDS=600
READINESS_TIMEOUT_SECONDS=3
VERSION_WRITE_MAX_RETRIES=2
TASK_TIMEOUT_SECONDS=120
FFMPEG_BINARY=ffmpeg
FFMPEG_TIMEOUT_SECONDS=120
MAX_PROJECT_UPLOADS=100
MAX_EXPORT_BUNDLE_BYTES=536870912
REQUEST_ID_HEADER=X-Request-ID
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
