FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system abachiwave \
    && adduser --system --ingroup abachiwave abachiwave

COPY support/yourmt3_service/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --requirement requirements.txt

COPY src/abachiwave/yourmt3_service.py ./app.py

# The checkpoint is not baked into the image: it is 536 MB and is not redistributed
# here. Mount it read-only at this path; the service verifies its SHA-256 on startup.
ENV MT3_CHECKPOINT_DIR=/models \
    NUMBA_CACHE_DIR=/tmp/numba-cache \
    HF_HUB_OFFLINE=1

USER abachiwave

EXPOSE 8080

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
